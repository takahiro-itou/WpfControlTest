
<Window x:Class="Views.MatrixEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ViewVb"
    xmlns:WpfControl="clr-namespace:WpfControl.Editor;assembly=WpfControl"
    Title="Matrix Editor Test Window"
    Height="450" Width="600"
>
  <Window.DataContext>
    <local:MatrixDataModel />
  </Window.DataContext>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Columns">
        <MenuItem Header="Expand" x:Name="mnuColExpand" />
        <MenuItem Header="Shrink" x:Name="mnuColShrink" />
      </MenuItem>
      <MenuItem Header="_Rows">
        <MenuItem Header="Expand" x:Name="mnuRowExpand" />
        <MenuItem Header="Shrink" x:Name="mnuRowShrink" />
      </MenuItem>
    </Menu>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <WpfControl:MatrixViewer
          Grid.Column="0"  Grid.Row="0"
          MatrixData="{Binding MatrixData}"
          Rows="{Binding TotalRows}"
          Columns="{Binding TotalColumns}"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
      >
        <WpfControl:MatrixViewer.Layouts>
          <WpfControl:MatrixLayout
              ColumnWidths="{Binding CustomWidths}"
              DefaultCellWidth="{Binding DefaultCellWidth}"
              DefaultCellHeight="{Binding DefaultCellHeight}"
              RowHeights="{Binding CustomHeights}"
          >
          </WpfControl:MatrixLayout>
        </WpfControl:MatrixViewer.Layouts>
      </WpfControl:MatrixViewer>
      <StackPanel
          Grid.Column="0"  Grid.Row="1"
          Orientation="Horizontal"
      >
        <TextBox
            IsReadOnly="True"
            Text="{Binding TotalColumns, Mode=OneWay}"
        />
        <TextBox
           IsReadOnly="True"
            Text="{Binding TotalRows, Mode=OneWay}"
        />
        <TextBox
            IsReadOnly="True"
            Text="{Binding DefaultCellWidth, Mode=OneWay}"
        />
        <TextBox
           IsReadOnly="True"
            Text="{Binding DefaultCellHeight, Mode=OneWay}"
        />
      </StackPanel>
    </Grid>
  </DockPanel>

</Window>
