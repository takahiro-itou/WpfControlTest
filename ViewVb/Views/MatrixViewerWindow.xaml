
<Window x:Class="Views.MatrixViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ViewVb"
    xmlns:WpfControl="clr-namespace:WpfControl.Editor;assembly=WpfControl"
    Title="Matrix Viewer Test Window"
    Height="450" Width="600"
>
  <Window.DataContext>
    <local:MatrixDataModel />
  </Window.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <WpfControl:MatrixViewer
        Grid.Column="0"  Grid.Row="0"
    />
    <StackPanel
        Grid.Column="0"  Grid.Row="1"
        Orientation="Horizontal"
    >
      <TextBox
          IsReadOnly="True"
          Text="{Binding TotalColumns, Mode=OneWay}"
      />
      <TextBox
          IsReadOnly="True"
          Text="{Binding TotalRows, Mode=OneWay}"
      />
    </StackPanel>
  </Grid>

</Window>
