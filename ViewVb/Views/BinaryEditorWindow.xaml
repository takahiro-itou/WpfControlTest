
<Window x:Class="Views.BinaryEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ViewVb"
    xmlns:WpfControl="clr-namespace:WpfControl.Editor;assembly=WpfControl"
    Title="ProgresseWindow"
    Height="450" Width="600"
>
  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="Options">
         <MenuItem Header="Cancelable" />
         <MenuItem Header="Pausable" />
      </MenuItem>
      <MenuItem Header="Run" />
    </Menu>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <WpfControl:BinaryEditor
          Grid.Column="0"  Grid.Row="0"
      />
    </Grid>

  </DockPanel>

</Window>
